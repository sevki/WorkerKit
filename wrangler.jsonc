// Deploys the example worker (Sources/HelloWorker) built by
// `swift package worker-build` to Cloudflare Workers — which runs on
// workerd itself, the same runtime this repository's e2e suite already
// verifies the build against (see Tests/e2e).
//
// `no_bundle: true` uploads `build/worker/worker.mjs` and
// `build/worker/WorkerKit.wasm` as-is, rather than letting wrangler's
// own esbuild bundler reprocess them: this is the exact artifact already
// tested against real workerd, unchanged.
//
// `name` must match the Worker's actual name in the Cloudflare dashboard
// exactly - wrangler uses it to decide which Worker a deploy updates, and
// this one was created there as "swift" (see workers/services/view/swift).
//
// Two bindings need a value only Cloudflare can hand out and aren't
// filled in here yet: `kv_namespaces[0].id`, from a real KV namespace, and
// `r2_buckets[0].bucket_name`, from a real R2 bucket. Until those are
// created (`wrangler kv namespace create WorkerKit-example-KV`,
// `wrangler r2 bucket create WorkerKit-example`) and filled in below,
// their bindings are omitted — /kv, /kv/<key>, /kv-bytes, /r2 and /r2/<key>
// will 500, everything else (/, /dining/*, /distributed/*, /counter/*,
// /rpc/add, /ws/echo, and the distributed-actor gateway) works.
{
	"name": "swift",
	"main": "build/worker/worker.mjs",
	"no_bundle": true,
	"compatibility_date": "2026-01-01",
	"vars": {
		"GREETING": "hello from a real Cloudflare Workers deployment"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "COUNTER", "class_name": "Counter" },
			{ "name": "FORKS", "class_name": "ForkObject" },
			{ "name": "PHILOSOPHERS", "class_name": "PhilosopherObject" },
			{ "name": "ECHO", "class_name": "EchoSocket" },
			// WorkerKitDistributed's gateway for native callers (served at
			// WorkersActorSystem.gatewayPath). It
			// stores nothing; SQLite-backed only because that's the kind
			// every plan supports.
			{ "name": "RPCGATEWAY", "class_name": "RPCGateway" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Counter", "ForkObject", "PhilosopherObject"] },
		{ "tag": "v2", "new_sqlite_classes": ["EchoSocket", "RPCGateway"] }
	],
	"services": [
		{ "binding": "SELF", "service": "swift" }
	]
}
